{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",         // module path to app
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend/app", // change working directory to backend
            "jinja": true
        }
    ]
}
